# Copy to .env (or export manually) for local development.
# The defaults below match docker-compose.yml (a local Postgres).

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=granatum
DB_USERNAME=granatum
DB_PASSWORD=granatum
DB_SSLMODE=disable
DB_PREPARE_THRESHOLD=5
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# --- Supabase instead of local Postgres --------------------------------
# See README.md#supabase for the tradeoffs between the three connection
# strings Supabase gives you. Example using the Session pooler (works with
# a normal Hikari pool, no extra tuning needed):
#
# DB_HOST=aws-0-eu-west-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your-db-password>
# DB_SSLMODE=require
# -------------------------------------------------------------------------

# openssl rand -base64 32
JWT_SECRET_BASE64=VGhpc0lzQURldk9ubHlEZWZhdWx0U2VjcmV0S2V5MTIzNA==
JWT_EXPIRATION_MINUTES=15
