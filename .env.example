# Copy to .env for local development:  cp .env.example .env
#
# This file IS load-bearing: `./gradlew :app:bootRun` and the test tasks read
# .env and pass it through as real environment variables (see
# build-logic/src/main/kotlin/DotEnv.kt). Spring Boot does not read .env by
# itself, and neither does Gradle out of the box.
#
# application.yml has NO fallback for the two secrets below. That is deliberate:
# a fallback means a missing variable in production boots the application with a
# value committed to this repository. Without one, it refuses to start - which
# is the correct failure.

# Local only. Unset, the application starts as prod (feature 006); bootRun
# falls back to dev on its own, so this line just makes it explicit. Never copy
# it to a deployment: dev serves POST /api/dev/token.
SPRING_PROFILES_ACTIVE=dev

# --- Database -------------------------------------------------------------
# These match docker-compose.yml, so `docker compose up -d` plus this file is
# all a local setup needs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=granatum
DB_USERNAME=granatum
DB_SSLMODE=disable
DB_PREPARE_THRESHOLD=5
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Required, no default in application.yml. For local work the value from
# docker-compose.yml is fine; in production it comes from the platform.
DB_PASSWORD=granatum

# --- Supabase instead of local Postgres ----------------------------------
# See README.md#supabase for the tradeoffs between the three connection
# strings Supabase gives you. Example using the Session pooler (works with
# a normal Hikari pool, no extra tuning needed):
#
# DB_HOST=aws-0-eu-west-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your-db-password>
# DB_SSLMODE=require
# -------------------------------------------------------------------------

# --- JWT ------------------------------------------------------------------
# Required, no default in application.yml. GENERATE YOUR OWN - do not copy a
# value from anywhere, including from this file's history:
#
#     openssl rand -base64 32
#
# Anyone who knows this key can mint a token with any role, so a shared or
# published one is equivalent to having no authentication at all.
JWT_SECRET_BASE64=
JWT_EXPIRATION_MINUTES=15

# --- auth (feature 002) ---------------------------------------------------
# Ninguna de estas es un secreto: son parametros de coste y de caducidad, y
# todas tienen un valor por defecto razonable en application.yml. Se listan
# aqui para que se vean y se puedan ajustar por entorno.
#
# Los parametros de Argon2 hay que RECALIBRARLOS en el hardware de destino:
# los valores de abajo cuestan ~110 ms en un Mac mini de 10 nucleos y pueden
# costar mucho mas en un contenedor pequeno. Procedimiento de medicion en
# specs/002-auth/research.md.
AUTH_REFRESH_EXPIRATION_DAYS=30
AUTH_ARGON2_MEMORY_KB=65536
AUTH_ARGON2_ITERATIONS=3
AUTH_ARGON2_PARALLELISM=1
AUTH_HASH_CONCURRENCY=4
AUTH_HASH_WAIT_MS=1000
AUTH_SESSION_PURGE_DAYS=30
# Dias que se conservan los eventos de seguridad (inicios de sesion, bloqueos...).
AUTH_SECURITY_EVENTS_RETENTION_DAYS=730

# --- registro del propietario (features 005 y 009) ---------------------------
# AUTH_BOOTSTRAP_CODE SI es un secreto: permite que el propietario se registre
# como primer ADMIN de una instalacion nueva y deja de servir en cuanto existe
# uno. Al resto del personal lo da de alta un ADMIN (POST /api/auth/onboarding).
# Vacio = registro desactivado. Generalo con `openssl rand -base64 24`, daselo
# solo al propietario, y quitalo del despliegue cuando ya exista.
AUTH_BOOTSTRAP_CODE=

# --- exportacion del registro (feature 003) ---------------------------------
# Ninguna es un secreto. Ver specs/003-timetracking-export/research.md D-002.
TIMETRACKING_EXPORT_CONCURRENCY=2
TIMETRACKING_EXPORT_WAIT_MS=1000
TIMETRACKING_EXPORT_TIMEOUT_SECONDS=120
TIMETRACKING_EXPORT_BATCH_SIZE=500
TIMETRACKING_VERIFICATION_MAX_BYTES=104857600

# Tomcat connection timeout: also bounds how long a stalled download client can
# hold a database connection (feature 003, D-002). Default 10s.
# SERVER_TOMCAT_CONNECTION_TIMEOUT=10s

# --- facturacion (feature 004) -----------------------------------------------
# Clave de la API de Claude (Anthropic). Es un SECRETO: nunca en un fichero
# versionado. Sin ella la facturacion funciona en modo manual: las facturas se
# guardan y se rellenan a mano, y no se envia nada a Claude.
# ANTHROPIC_API_KEY=
# INVOICES_CLAUDE_MODEL=claude-sonnet-5-5
# INVOICES_CLAUDE_EFFORT=medium
# INVOICES_RECOGNITION_CONCURRENCY=3
# INVOICES_RECOGNITION_TIMEOUT_SECONDS=120
# INVOICES_MAX_REQUEST_SIZE=50MB
# INVOICES_MAX_BYTES_PER_FILE=10485760
# INVOICES_PDF_MAX_PAGES=20

# --- imagenes del inventario (feature 010) -----------------------------------
# Bucket PRIVADO de Supabase Storage para la imagen de cada material. La clave
# service_role es un SECRETO con acceso total al proyecto Supabase: nunca en un
# fichero versionado. Sin URL o sin clave el inventario funciona y solo se
# rechaza la subida de imagenes. El bucket se crea una vez por entorno (ver
# docs/DESPLIEGUE.md).
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# INVENTORY_IMAGES_BUCKET=materiales
# INVENTORY_IMAGES_URL_SECONDS=3600
# INVENTORY_IMAGES_MAX_BYTES=10485760
# INVENTORY_IMAGES_TIMEOUT_SECONDS=30

# Events (feature 011): when the events of past days are finished and their
# material returned to the inventory. Spring cron, Europe/Madrid.
# EVENTS_FINISHING_CRON=0 5 0 * * *

# --- endurecimiento (feature 006) -------------------------------------------
# Ninguna es un secreto. Cupos por direccion de origen como N/periodo, u "off".
# Ver specs/006-hardening-deploy/research.md D-003.
SECURITY_RATE_LIMIT_LOGIN=10/1m
SECURITY_RATE_LIMIT_SESSION=30/1m
SECURITY_RATE_LIMIT_SIGN_UP=5/1h
SECURITY_RATE_LIMIT_GENERAL=300/1m
SECURITY_RATE_LIMIT_MAX_ADDRESSES=10000
# "native" solo detras de un proxy o balanceador de confianza (D-002).
SERVER_FORWARD_HEADERS_STRATEGY=none
# Origenes de navegador admitidos, separados por comas. Vacio = ninguno.
CORS_ALLOWED_ORIGINS=

# --- ausencias (feature 007) -------------------------------------------------
# Derecho anual de vacaciones en dias naturales cuando el ADMIN no ha fijado otro.
ABSENCES_VACATION_ANNUAL_DAYS=30

# --- notificaciones (feature 008) ----------------------------------------------
# Horas con un fichaje abierto antes de avisar de la salida olvidada.
TIMETRACKING_MISSING_CLOCK_OUT_HOURS=10
# Dias tras los que se borran los avisos leidos, y cualquier aviso.
NOTIFICATIONS_READ_DAYS=90
NOTIFICATIONS_ALL_DAYS=180

# --- Google Sheets (feature 012) ---
# Copia de los fichajes (al exportar un mes) y de las facturas confirmadas en dos
# hojas de calculo de Google, con una cuenta de servicio. Ver README.md#copia-en-google-sheets.
#
# GOOGLE_SHEETS_CREDENTIALS_FILE SI es un SECRETO: la ruta a un fichero JSON con
# la clave de la cuenta de servicio, FUERA del repositorio (p. ej. un secreto
# montado en el servidor). Nunca el JSON en si, ni el fichero en el repositorio.
# Vacia o sin definir = integracion desactivada; el resto de la app funciona igual.
# No se usa GOOGLE_APPLICATION_CREDENTIALS ni el descubrimiento automatico de
# credenciales de Google (research D-001). PRE y PRO usan cuentas distintas.
# GOOGLE_SHEETS_CREDENTIALS_FILE=
# Frecuencia del trabajador que escribe en Google (cron de Spring, 6 campos).
SHEETS_WORKER_CRON=*/30 * * * * *
# Intentos antes de dar una escritura por fallida (visible en /api/sheets/status).
SHEETS_MAX_ATTEMPTS=8
# Solo para ./gradlew :features:sheets:sheetsRealTest (hoja de prueba de PRE).
# SHEETS_TEST_SPREADSHEET_ID=

# --- contrato de la API (OpenAPI) -------------------------------------------
# /v3/api-docs y /swagger-ui.html. Activo por defecto en el perfil dev; en prod,
# solo si se pone a true. La copia para las apps esta en docs/openapi.json.
OPENAPI_ENABLED=true
